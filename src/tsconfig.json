{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "strict": false,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": [
    "config/**/*.js",
    "controllers/**/*.js",
    "middlewares/**/*.js",
    "migrations/**/*.js",
    "repositories/**/*.js",
    "routes/**/*.js",
    "Services/**/*.js"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
